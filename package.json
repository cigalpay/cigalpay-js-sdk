    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cigalpay/cigalpay-js-sdk.git"
  },
  "keywords": [
    "cigalpay",
    "crypto",
    "payments",
    "payment-gateway",
    "bitcoin",
    "usdt",
    "webhook",
    "checkout",
    "sdk"
  ],
  "author": "cigalpay",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cigalpay/cigalpay-js-sdk/issues"
  },
  "homepage": "https://cigalpay.com/developers",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./cigalpay-sdk.js",
      "default": "./cigalpay-sdk.js"
    }
  },
  "files": [
    "cigalpay-sdk.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
